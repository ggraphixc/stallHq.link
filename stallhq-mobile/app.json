{
  "expo": {
    "name": "stallHq",
    "slug": "stallhq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "stallhq",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stallhq.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0f",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.stallhq.app",
      "versionCode": 8
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      [
        "expo-updates",
        {
          "url": "https://u.expo.dev/e7290b84-fabd-4bc4-904a-9c2dcf422129"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#a855f7"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06060b",
          "image": "./assets/android-icon-foreground.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#06060b"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e7290b84-fabd-4bc4-904a-9c2dcf422129"
      }
    },
    "owner": "ggraphixc",
    "updates": {
      "url": "https://u.expo.dev/e7290b84-fabd-4bc4-904a-9c2dcf422129",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 300
    }
  }
}
